# OmniRoute secure home-LAN deployment template
# Copy to .env and replace every REQUIRED value before starting.

NODE_ENV=production
DATA_DIR=/app/data

# REQUIRED: generate independently; never reuse values.
# openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_RANDOM_VALUE
# openssl rand -hex 32
API_KEY_SECRET=REPLACE_WITH_RANDOM_VALUE
# openssl rand -hex 32
STORAGE_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_VALUE
STORAGE_ENCRYPTION_KEY_VERSION=v1
# Use a password-manager generated value of at least 24 characters.
INITIAL_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD

# Host address used by Docker port publishing.
# Set this to the OmniRoute VM/server address on the trusted home VLAN.
# Do NOT use 0.0.0.0. Example: 192.168.20.40
OMNIROUTE_BIND_IP=REPLACE_WITH_TRUSTED_LAN_IP

PORT=20128
DASHBOARD_PORT=20128
API_PORT=20129
LIVE_WS_PORT=20132

# List every trusted browser origin that may open the live WebSocket.
# Example: http://192.168.20.40:20128,https://omniroute.home.example
LIVE_WS_ALLOWED_ORIGINS=REPLACE_WITH_TRUSTED_ORIGINS

# Authentication remains mandatory even on the home LAN.
REQUIRE_API_KEY=true
# Use true behind HTTPS. For direct HTTP-only LAN testing, set false temporarily.
AUTH_COOKIE_SECURE=true

# Cloud sync is intentionally disabled. This does not disable normal AI providers.
CLOUD_URL=
NEXT_PUBLIC_CLOUD_URL=
OMNIROUTE_CLOUD_SYNC_SECRETS=false

# Reduce sensitive data persistence.
PII_RESPONSE_SANITIZATION=true
OMNIROUTE_PROXY_FETCH_DEBUG=
OMNIROUTE_DEBUG_COMPLETION=

# Required only when the memory/Qdrant profile is enabled.
# openssl rand -hex 32
QDRANT_API_KEY=REPLACE_BEFORE_ENABLING_MEMORY_PROFILE

# The agent profile uses ./agent-home and ./agent-workspace only.
# Put dedicated SSH keys, kubeconfig and CLI sessions there; do not copy your full host home.
# Recommended deployment targets: SSH, HTTPS APIs, GitOps and Kubernetes API.

OMNIROUTE_ENABLE_LIVE_WS=1
