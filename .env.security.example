# OmniRoute secure deployment template
# Copy to .env and replace every REQUIRED value before starting.

NODE_ENV=production
DATA_DIR=/app/data

# REQUIRED: generate independently; never reuse values.
# openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_RANDOM_VALUE
# openssl rand -hex 32
API_KEY_SECRET=REPLACE_WITH_RANDOM_VALUE
# openssl rand -hex 32
STORAGE_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_VALUE
STORAGE_ENCRYPTION_KEY_VERSION=v1
# Use a password manager-generated value of at least 24 characters.
INITIAL_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD

# Network: the Compose file publishes these only on 127.0.0.1.
PORT=20128
DASHBOARD_PORT=20128
API_PORT=20129
API_HOST=127.0.0.1
LIVE_WS_PORT=20132
LIVE_WS_HOST=127.0.0.1
LIVE_WS_ALLOWED_ORIGINS=http://localhost:20128,http://127.0.0.1:20128

# Authentication and cookies.
REQUIRE_API_KEY=true
AUTH_COOKIE_SECURE=true

# Cloud sync is intentionally disabled.
CLOUD_URL=
NEXT_PUBLIC_CLOUD_URL=
OMNIROUTE_CLOUD_SYNC_SECRETS=false

# Reduce sensitive data persistence.
PII_RESPONSE_SANITIZATION=true
OMNIROUTE_PROXY_FETCH_DEBUG=
OMNIROUTE_DEBUG_COMPLETION=

# Required only when the memory/Qdrant profile is enabled.
# openssl rand -hex 32
QDRANT_API_KEY=REPLACE_BEFORE_ENABLING_MEMORY_PROFILE

# Keep privileged features disabled until individually reviewed.
OMNIROUTE_ENABLE_LIVE_WS=1
# MCP, plugins, MITM, VNC, traffic inspection, custom middleware and auto-update
# should remain disabled in the dashboard unless explicitly required.
